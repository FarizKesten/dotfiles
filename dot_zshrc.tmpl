# Enable Powerlevel10k instant prompt (must be near top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Initialize zsh completions first (fixes compdef errors)
autoload -U compinit
compinit
autoload -U bashcompinit
bashcompinit

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Oh My Zsh plugins (keep your favorites)
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  web-search
  vi-mode
  {{- if eq .chezmoi.os "darwin" }}
  brew
  macos
  {{- end }}
  {{- if eq .chezmoi.os "linux" }}
  ubuntu
  systemd
  {{- end }}
)

# Vi-mode enhancements
export VI_MODE_SET_CURSOR=true

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# === Development Environment Setup ===
# DevBox global environment
eval "$(devbox global shellenv --init-hook)"

# DevBox completions
eval "$(devbox completion zsh)"

# DevBox aliases for convenience
alias dglobal="devbox global"
alias dshell="devbox shell"
alias drun="devbox run"

{{- if eq .chezmoi.os "darwin" }}
# macOS-specific paths and tools
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Conda setup (macOS)
if [ -f "/Users/{{ .chezmoi.username }}/anaconda3/bin/conda" ]; then
  __conda_setup="$('/Users/{{ .chezmoi.username }}/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "/Users/{{ .chezmoi.username }}/anaconda3/etc/profile.d/conda.sh" ]; then
      . "/Users/{{ .chezmoi.username }}/anaconda3/etc/profile.d/conda.sh"
    else
      export PATH="/Users/{{ .chezmoi.username }}/anaconda3/bin:$PATH"
    fi
  fi
  unset __conda_setup
fi

# NVM setup (macOS)
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

{{- else if eq .chezmoi.os "linux" }}
# Linux-specific setup
export PATH="$HOME/.local/bin:$PATH"

# Conda setup (Linux) - adjust path as needed
if [ -f "$HOME/anaconda3/bin/conda" ]; then
  __conda_setup="$('$HOME/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
      . "$HOME/anaconda3/etc/profile.d/conda.sh"
    else
      export PATH="$HOME/anaconda3/bin:$PATH"
    fi
  fi
  unset __conda_setup
fi

# NVM setup (Linux)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{- end }}

# === Modern Tool Integration ===

# Enhanced fzf integration
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  source <(fzf --zsh)
fi

# Chezmoi completions
if command -v chezmoi >/dev/null 2>&1; then
  eval "$(chezmoi completion zsh)"
fi

# === Custom Functions ===

# Fuzzy directory navigation (your existing function)
fcd() {
  local dir 
  dir=$(find ${1:-.} -type d -not -path '*/\.*' 2> /dev/null | fzf +m) && cd "$dir"
}

# Enhanced fuzzy file search
fvim() {
  local file
  file=$(fd --type f --hidden --follow --exclude .git | fzf +m) && nvim "$file"
}

# === Aliases ===

# Your existing aliases (with cross-platform compatibility)
alias vim='nvim'
alias cat='bat'
{{- if eq .chezmoi.os "darwin" }}
alias ls='eza'
{{- else }}
alias ls='eza'  # Will be installed via Ansible
{{- end }}

# TMUX
export PATH="$HOME/.tmuxifier/bin:$PATH"
eval "$(tmuxifier init -)"
code() {
  if [[ -z "$1" ]]; then
    echo "Usage: dev <project-path>"
    return 1
  fi
  
  export TMUX_PROJECT_PATH="$1"
  export TMUX_PROJECT_NAME="$(basename $1)"
  tmuxifier load-session dev
}

# Add tab completion for directories
_code() {
  _arguments \
    '1:project directory:_directories'
}
compdef _code code


#chezmoi
alias cz='chezmoi apply && source ~/.zshrc'

# Modern replacements
alias find='fd'
alias grep='rg'
alias top='htop'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# === Environment Cleanup ===
unset SUDO_UID SUDO_GID SUDO_USER

# === Shell Histor ===
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# === Load Powerlevel10k config ===
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Personal machine specific settings
export EDITOR='nvim'
export BROWSER='open'


# Work machine specific settings
# Add any work-specific configurations here

