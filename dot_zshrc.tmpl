{{- if eq .chezmoi.os "darwin" }}
# macOS-specific paths and tools
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# NVM setup (macOS)
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

{{- else if eq .chezmoi.os "linux" }}
# Linux-specific setup
export PATH="$HOME/.local/bin:$PATH"

# NVM setup (Linux)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{- end }}

# TMUX
export PATH="$HOME/.tmuxifier/bin:$PATH"

eval "$(tmuxifier init -)"
code() {
  if [[ -z "$1" ]]; then
    echo "Usage: dev <project-path>"
    return 1
  fi

  export TMUX_PROJECT_PATH="$1"
  export TMUX_PROJECT_NAME="$(basename $1)"
  tmuxifier load-session dev
}

# Add tab completion for directories
_code() {
  _arguments \
    '1:project directory:_directories'
}
compdef _code code

# === Modern Tool Integration ===

# Enhanced fzf integration
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  source <(fzf --zsh)
fi

# Chezmoi completions

alias chezmoi=$HOME/bin/chezmoi
if command -v chezmoi >/dev/null 2>&1; then
  alias chezmoi=$HOME/bin/chezmoi
fi
eval "$(chezmoi completion zsh)"

export CHEZMOI_SECRET_BACKEND=gopass

# === Custom Functions ===

# Fuzzy directory navigation (your existing function)
fcd() {
  local dir
  dir=$(find ${1:-.} -type d -not -path '*/\.*' 2>/dev/null | fzf +m) && cd "$dir"
}

# Enhanced fuzzy file search
fvim() {
  local file
  file=$(fd --type f --hidden --follow --exclude .git | fzf +m) && nvim "$file"
}

# === Aliases ===

# Your existing aliases (with cross-platform compatibility)
alias vim='nvim'
{{- if eq .chezmoi.os "darwin" }}
alias ls='eza'
alias cat='bat'
{{- else }}
alias ls='eza'
alias cat='batcat'
{{- end }}

alias lg=lazygit
alias c=clear

#chezmoi
alias cz='chezmoi'
alias cza='chezmoi apply && source ~/.zshrc'
alias czg='lazygit -path $(chezmoi source-path)'

# Modern replacements
alias find='fd'
alias grep='rg'
alias top='htop'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

#zoxide
eval "$(zoxide init --cmd cd zsh)"

# brew (macOS)
{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else if eq .chezmoi.os "linux" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{end}}

# === Environment Cleanup ===
unset SUDO_UID SUDO_GID SUDO_USER

# === Shell History ===
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# === Load Powerlevel10k config ===
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Personal machine specific settings
# export EDITOR='nvim'
export EDITOR="$(mise which nvim)"
export VISUAL="$EDITOR"
export EDITOR='nvim'
export BROWSER='open'

# mise settings
# echo 'eval "$(~/.local/bin/mise activate zsh)"' >> ~/.zshrc
WORK_STATUS=$(chezmoi cat-config | grep "^work:" | awk '{print $2}')
WSL_STATUS=$(chezmoi cat-config | grep "^wsl:" | awk '{print $2}')

if [ "$WORK_STATUS" = "true" ]; then
  if [ "$WSL_STATUS" = "true" ]; then
    PROXY="http://wsl-proxy:3129"
  else
    PROXY="http://localhost:3128"
  fi
  export http_proxy="$PROXY"
  export HTTP_PROXY="$PROXY"
  export https_proxy="$PROXY"
  export HTTPS_PROXY="$PROXY"
  export ftp_proxy="$PROXY"
  export FTP_PROXY="$PROXY"
  export all_proxy="$PROXY"
  export ALL_PROXY="$PROXY"
  export no_proxy='localhost,127.0.0.*,192.168.*,172.*,*.local,*.bosch.*'
fi
