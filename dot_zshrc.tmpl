# Enable Powerlevel10k instant prompt (must be near top)
USER_NAME=${USER:-$(whoami)}
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-$USER_NAME.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-$USER_NAME.zsh"
fi

#Conda
if [ -d "$HOME/miniconda3" ]; then
  # Linux or bash-script install macOS
  eval "$($HOME/miniconda3/bin/conda shell.zsh hook)"
elif [ -d "/opt/homebrew/Caskroom/miniconda/latest/miniconda3" ]; then
  # macOS Homebrew Apple Silicon
  eval "$(/opt/homebrew/Caskroom/miniconda/latest/miniconda3/bin/conda shell.zsh hook)"
elif [ -d "/usr/local/Caskroom/miniconda/latest/miniconda3" ]; then
  # macOS Homebrew Intel
  eval "$(/usr/local/Caskroom/miniconda/latest/miniconda3/bin/conda shell.zsh hook)"
fi
# Auto-activate conda environment based on .conda-env file
autoload -U add-zsh-hook

function auto_conda_env() {
  if [ -f ".conda-env" ]; then
    local env_name
    env_name=$(<.conda-env)
    if [[ "$(basename $CONDA_PREFIX)" != "$env_name" ]]; then
      conda activate "$env_name"
    fi
  fi
}

add-zsh-hook chpwd auto_conda_env
# Also trigger for the initial directory
auto_conda_env

# mise settings
# Only activate mise once
if [[ -z "$MISE_ACTIVATED" ]]; then
  eval "$(~/.local/bin/mise activate zsh)"
  export MISE_ACTIVATED=1
fi
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Initialize zsh completions first (fixes compdef errors)
autoload -U compinit
compinit
autoload -U bashcompinit
bashcompinit

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Oh My Zsh plugins (keep your favorites)
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  web-search
  vi-mode
  {{- if eq .chezmoi.os "darwin" }}
  brew
  macos
  {{- end }}
  {{- if eq .chezmoi.os "linux" }}
  ubuntu
  systemd
  {{- end }}
)

# Vi-mode enhancements
export VI_MODE_SET_CURSOR=true

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

