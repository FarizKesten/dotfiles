#!/bin/bash
# run_once_03_setup_shell_integration.sh.tmpl

set -e

echo "🐚 Setting up shell integration..."

# Ensure devbox is in PATH
export PATH="$HOME/.local/bin:$PATH"

SHELL_RC=""
if [ "$SHELL" = "/bin/zsh" ] || [ "$SHELL" = "/usr/bin/zsh" ]; then
    SHELL_RC="$HOME/.zshrc"
elif [ "$SHELL" = "/bin/bash" ] || [ "$SHELL" = "/usr/bin/bash" ]; then
    SHELL_RC="$HOME/.bashrc"
fi

if [ -n "$SHELL_RC" ] && [ -f "$SHELL_RC" ]; then
    # Check if devbox integration already exists
    if ! grep -q "devbox global shellenv" "$SHELL_RC"; then
        echo "Adding DevBox integration to $SHELL_RC"
        echo "" >> "$SHELL_RC"
        echo "# DevBox global integration" >> "$SHELL_RC"
        echo 'eval "$(devbox global shellenv --init-hook)"' >> "$SHELL_RC"
        echo 'eval "$(devbox completion zsh)"' >> "$SHELL_RC"
        echo "Shell integration added ✅"
    else
        echo "DevBox integration already exists ✅"
    fi
fi

echo "Shell integration setup complete!"
