#!/bin/bash
# run_once_install_global_tools.sh.tmpl
# developer-tools.yml hash: {{ include "developer-tools.yml" | sha256sum}}

set -e

echo "🔧 Setting up global development tools..."

# Or manually add tools:
devbox global add ripgrep fzf git tmux curl wget jq zsh fd neovim nodejs lazygit tree-sitter

# Add shell integration
echo eval "$(devbox global shellenv)" >> ~/.zshrc && source ~/.zshrc
refresh-global

# Install npm tools
npm install -g @bitwarden/cli tree-sitter-cli

# Execute the playbook
# ansible-playbook developer-tools.yml -i localhost, --connection=local
