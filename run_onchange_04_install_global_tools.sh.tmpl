#!/bin/bash
# run_once_install_global_tools.sh.tmpl
# developer-tools.yml hash: {{ include "developer-tools.yml" | sha256sum}}

set -e

echo "🔧 Setting up global development tools..."

#------------------------------mise
mise use -g fd
mise use -g eza
mise use -g fzf
mise use -g jq
mise use -g lazygit
mise use -g neovim
mise use -g nodejs
mise use -g ripgrep
mise use -g tree-sitter
mise use -g tmux
mise use -g gopass
mise use -g bat
mise use -g aqua:gopasspw/gopass

# workaround for eza
if ! command -v eza >/dev/null 2>&1; then
  {{- if eq .chezmoi.os "darwin" }}
  brew install eza
  {{- end }}

  {{- if eq .chezmoi.os "linux" }}
  # Download pre-built binary
  wget https://github.com/eza-community/eza/releases/latest/download/eza_x86_64-unknown-linux-gnu.tar.gz
  tar -xzf eza_x86_64-unknown-linux-gnu.tar.gz
  sudo mv eza /usr/local/bin/
  rm -rf eza_x86_64-unknown-linux-gnu.tar.gz
  {{- end }}

fi

{{- if eq .chezmoi.os "darwin" }}
brew install bat
brew install luarocks
brew install imagemagick pkg-config
pip install pynvim jupyter_client ipykernel debugpy
{{- end }}
{{- if eq .chezmoi.os "linux" }}

sudo apt install -y xclip
sudo apt install -y bat
sudo apt update && sudo apt install libmagickwand-dev pkgconf
pip install pynvim jupyter_client ipykernel debugpy
sudo apt install -y luarocks
{{- end }}

pip install jupyter-client jupytext cairosvg pnglatex plotly kaleido pyperclip nbformat
# Install required packages
pip install pynvim jupyter_client ipykernel debugpy
pip install matplotlib seaborn plotly pandas numpy scipy
pip install cairosvg pnglatex kaleido pyperclip nbformat pillow

# Register as Jupyter kernel
python -m ipykernel install --user --name jupyter-nvim --display-name "Python (Neovim)"
npm install -g neovim

