#!/bin/bash
# run_once_04_setup_devbox_sync.sh.tmpl

set -e

echo "🔄 Setting up DevBox global sync..."

# Ensure devbox is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Navigate to devbox global directory
DEVBOX_GLOBAL_DIR=$(devbox global path)
cd "$DEVBOX_GLOBAL_DIR"

# Initialize git if not already done
if [ ! -d .git ]; then
    echo "Initializing git repository for DevBox global config..."
    git init
    git add .
    git commit -m "Initial DevBox global configuration"
    echo "Git repository initialized ✅"
else
    echo "Git repository already initialized ✅"
fi

echo "DevBox sync setup complete!"
echo "To sync with remote repository later, run:"
echo "  cd $(devbox global path)"
echo "  git remote add origin <your-repo-url>"
echo "  git push -u origin main"
